{
  "name": "hearth-and-honey-tools",
  "private": true,
  "type": "module",
  "description": "Local helper scripts for the Hearth & Honey site. Not needed to deploy.",
  "scripts": {
    "build:illustrations": "node make-illustrations.mjs",
    "build:images": "node build-images.mjs",
    "fetch:fonts": "node fetch-fonts.mjs",
    "serve": "node serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify:contrast": "node verify/contrast.mjs",
    "verify:html": "html-validate --config .htmlvalidate.json \"../*.html\" \"../*/index.html\"",
    "verify:links": "node verify/links.mjs",
    "verify:jsonld": "node verify/jsonld.mjs",
    "verify:axe": "node verify/axe.mjs",
    "verify:lh": "node verify/lighthouse.mjs",
    "verify": "npm run test && npm run verify:contrast && npm run verify:html && npm run verify:links && npm run verify:jsonld && npm run verify:axe && npm run verify:lh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "html-validate": "^11.14.0",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "potrace": "^2.1.8",
    "sharp": "^0.35.4"
  }
}
